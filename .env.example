# ---------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
# ---------------------------------------------------------------------------
# Project API URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (sb_publishable_... or the legacy anon JWT).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — server only (NEVER expose to the browser, never commit)
# ---------------------------------------------------------------------------
# Service-role key. Used solely by server-only admin actions (user invites /
# role changes / deactivation) that must bypass RLS. Keep out of client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------
# Base URL of the deployment (used for auth redirects / magic links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inactivity auto-logout window in minutes (spec: 8 hours = 480).
NEXT_PUBLIC_INACTIVITY_TIMEOUT_MINUTES=480
